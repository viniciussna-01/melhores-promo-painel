# ---------------------------------------------------------------------------
# sync_agent.py  ->  copie para  .env  e preencha
# ---------------------------------------------------------------------------

# Chave da conta de servico do Firebase (JSON).
# Firebase Console -> engrenagem -> Configuracoes do projeto -> Contas de servico
#   -> "Gerar nova chave privada"  ->  salve o arquivo aqui na pasta sync/.
# Esse arquivo e SECRETO: fica so aqui, nunca vai pro painel/Vercel/GitHub.
FIREBASE_SA_KEY=C:\Users\Vinicius\.claude\whatsapp hydra\melhores-promo-painel\sync\serviceAccountKey.json

# Pasta data/ do bot. LEITURA dos arquivos do bot; a UNICA escrita e o
# arquivo novo data/control.json (estado de pausa que o worker le - ver
# services/control_state.py no bot). Nada mais do bot e tocado.
BOT_DATA_DIR=C:\Users\Vinicius\Downloads\Progamação\sistema_afiliado\sistema_afiliado\data

# Sessao do Telethon - usada so para checar o mtime (o bot esta vivo?).
# Opcional; se em branco, o "worker vivo?" usa so os arquivos de data/.
BOT_SESSION_FILE=C:\Users\Vinicius\Downloads\Progamação\sistema_afiliado\sistema_afiliado\affiliate_bot_session.session

# Cadencia da leitura (segundos). 2s = quase tempo real.
SYNC_INTERVAL_SECONDS=2

# A cada quantos segundos recalcular os totais (hoje / erros / por grupo).
STATUS_RECOUNT_SECONDS=15

# A cada quantos segundos checar comandos do painel (pausar/retomar).
# 10s = a pausa chega ao bot em ~10s. Nao deixe muito baixo (leituras Firestore).
COMMAND_POLL_SECONDS=10

# Silencio (min) sem nenhum arquivo do bot mudar -> marca worker "sem_sinal".
WORKER_SILENCE_MINUTES=12
